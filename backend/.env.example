# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL=postgresql://klosado:klosado@localhost:5432/klosado
REDIS_URL=redis://localhost:6379/0

# hcnsec (DeepSeek pool) — uses the Secure Vault credential, no raw key here.
HCNSEC_MODEL_VOLUME=DeepSeek-V4.1-Flash
HCNSEC_MODEL_SMART=DeepSeek-V4-Pro

# Gemini (long-context tasks) — set when needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama / Qwen (private + batch tasks).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Default monthly token budget per client (0 = unlimited, dev only).
DEFAULT_MONTHLY_TOKEN_BUDGET=2000000
